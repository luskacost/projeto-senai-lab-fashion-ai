# Version Control
.git
.gitignore

# Python & Cache
__pycache__/
*.pyc
.pytest_cache/

# Virtual Environments
venv/
.venv/

# Secrets and Tenant Specific Data (montados via volume/env_file no docker-compose, não copiados
# pra dentro da imagem)
.env
tenant_data/
logs/

# Frontend (imagem separada, ver frontend/Dockerfile)
frontend/node_modules/
frontend/.next/

# IDE Configuration Files
.vscode/
.idea/
.claude/

# CI e outros arquivos que não fazem sentido dentro da imagem
.github/

# Lembrete pessoal de comandos (git-ignorado, nunca deveria ir pra imagem mesmo se existir
# localmente -- ver nota em .gitignore)
executavel.txt

# Ferramentas de análise/benchmark locais (nunca versionadas, ver .gitignore)
scratch/
